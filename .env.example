# ============================================================================
# HARDTEC INTELLIGENT TICKETING - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values for production
# Do NOT commit .env to version control - it contains sensitive credentials
# ============================================================================

# ============================================================================
# SNOWFLAKE CONFIGURATION
# ============================================================================
# Set these to empty or "dev" for local development without Snowflake
# For production, provide actual Snowflake account credentials

SNOWFLAKE_ACCOUNT=your_account_name
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=HARDTEC_DB
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_ROLE=ACCOUNTADMIN

# ============================================================================
# MINIO OBJECT STORAGE CONFIGURATION
# ============================================================================
# Used for data lake and artifact storage (optional)

MINIO_ROOT_USER=your_minio_user
MINIO_ROOT_PASSWORD=your_minio_password

# ============================================================================
# API SERVER CONFIGURATION
# ============================================================================

API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# ============================================================================
# STREAMLIT DASHBOARD CONFIGURATION
# ============================================================================

STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

LOG_LEVEL=INFO
LOG_FORMAT=json

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# SQLite local database path (relative to /app/data/)
DB_PATH=data/lake/tickets_predictions.db

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable/disable Snowflake persistence (gracefully falls back to SQLite)
ENABLE_SNOWFLAKE_PERSISTENCE=true

# Enable/disable dbt integration
ENABLE_DBT_INTEGRATION=false

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================

# Enable request/response logging
ENABLE_REQUEST_LOGGING=true

# Enable performance metrics
ENABLE_METRICS=true

# ============================================================================
# SECURITY
# ============================================================================

# Set true in staging/production to require X-API-Key on business endpoints.
API_AUTH_ENABLED=false

# API authentication secret (use a strong random value in production)
API_SECRET_KEY=your_super_secret_key_change_this_in_production

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8501

# ============================================================================
# ENVIRONMENT
# ============================================================================

ENVIRONMENT=development  # Options: development, staging, production
DEBUG=false
